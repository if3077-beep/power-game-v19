{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true
  },
  "include": [
    "*.js",
    "*.html"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "TrendRadar",
    "mirofish-v7",
    "mirofish-v9",
    "mirofish-v12"
  ]
}